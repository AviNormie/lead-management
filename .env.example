# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase Auth (anon key is public; service role is SERVER ONLY)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Copy from Supabase Dashboard → Connect. Do not use localhost.
#
# DATABASE_URL = Transaction pooler (app runtime, serverless)
#   postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&connection_limit=1
#
# DIRECT_URL = Session pooler (Prisma migrate / introspect)
#   postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# Direct db.[PROJECT_REF].supabase.co is IPv6-only and often does not resolve;
# use the session pooler on port 5432 instead.
DATABASE_URL=
DIRECT_URL=

# AES key material for encrypting future integration credentials
ENCRYPTION_KEY=
