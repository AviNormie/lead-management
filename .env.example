# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase Auth (anon key is public; service role is SERVER ONLY)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma / Postgres — copy from Supabase → Settings → Database → Connection string
# DATABASE_URL = Transaction pooler (port 6543), append ?pgbouncer=true if not included
# DIRECT_URL   = Session pooler (port 5432) on the same pooler host
# Use the database password from Supabase (reset it there if login fails).
DATABASE_URL=
DIRECT_URL=

# AES key material for encrypting future integration credentials
ENCRYPTION_KEY=
